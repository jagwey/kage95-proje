{
  "name": "kage95-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "build:pages": "tsc -b && vite build --mode pages",
    "db:setup": "node --env-file-if-exists=.env server/setup.mjs",
    "dev:api": "node --env-file-if-exists=.env --watch server/index.mjs",
    "dev:api:dotnet": "dotnet watch --project server-dotnet/Kage95.Api run",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "start:dotnet": "dotnet run --project server-dotnet/Kage95.Api"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "lucide-react": "^0.468.0",
    "mysql2": "^3.24.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "typescript": "~5.9.0",
    "vite": "^8.0.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
